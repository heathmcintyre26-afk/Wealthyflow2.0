# WealthyFlow environment variables
# Copy this file to .env.local and fill in the values

# Admin wallet address — only this Ethereum address can access /admin
# Leave empty to allow any connected wallet to access admin (development only)
# VITE_ADMIN_ADDRESS=0xYourAdminWalletAddressHere

# Example: backend API base URL
# VITE_API_BASE_URL=https://api.example.com

# Example: third-party analytics / tracking key
# VITE_ANALYTICS_KEY=your_key_here
