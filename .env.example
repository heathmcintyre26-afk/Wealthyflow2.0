# WealthyFlow environment variables
# Copy this file to .env.local and fill in the real values

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Stripe ────────────────────────────────────────────────────────────────────
# Found in: Stripe Dashboard → Developers → API keys (publishable key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Stripe Price IDs for subscription tiers (created in Stripe Dashboard)
VITE_STRIPE_PRO_PRICE_ID=price_pro_monthly
VITE_STRIPE_PREMIUM_PRICE_ID=price_premium_monthly

# ── CoinGecko (optional) ──────────────────────────────────────────────────────
# Leave blank to use the free public API (rate-limited).
# Set to your CoinGecko Pro base URL if you have a paid key.
# VITE_API_BASE_URL=https://pro-api.coingecko.com/api/v3
